{
  "name": "firetv",
  "version": "1.0.0",
  "description": "Control Amazon Fire TV devices through ADB",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "bin": {
    "firetv": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "@types/blessed": "^0.1.27",
    "android-tools-bin": "^2.0.1",
    "blessed": "^0.1.81",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.20.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0"
  }
}
